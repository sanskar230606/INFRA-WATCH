# Backend Environment Variables Template
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Allowed CORS Origins (comma-separated for multiple origins, e.g., your Amplify domain)
ALLOWED_ORIGINS=http://localhost:5173,https://main.d123456abcdefg.amplifyapp.com
